{
  "name": "shelldeck",
  "version": "1.0.10",
  "private": true,
  "description": "Windows 便携 SSH/SFTP 桌面工作台",
  "author": "ShellDeck",
  "main": "electron/main.cjs",
  "scripts": {
    "postinstall": "node scripts/install-electron.cjs",
    "dev": "concurrently -k \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:web": "vite build",
    "start": "electron .",
    "icons": "node scripts/make-icons.cjs",
    "release": "node scripts/make-release.cjs",
    "dist": "npm run build:web && node scripts/prune-native.cjs && electron-builder --win dir && node scripts/package-folder.cjs",
    "e2e": "node scripts/e2e.cjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "ssh2": "^1.17.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.11",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.0.0",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.65.1",
    "vite": "^7.3.8",
    "vue": "^3.5.45",
    "wait-on": "^9.5.1"
  }
}
